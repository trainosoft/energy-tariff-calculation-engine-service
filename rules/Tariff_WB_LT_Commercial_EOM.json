    {
      "id": "d66e0bd1-b23e-4092-accc-d623fdec0986",
      "name": "Test Result and Daily to match calculation",
      "type": "expressionNode",
      "content": {
        "inputField": null,
        "outputPath": null,
        "expressions": [
          {
            "id": "3963f4ac-08d1-4ec9-a374-c98a860bbeb5",
            "key": "demand_charges",
            "value": "round((fixed_charges*WB_LT_remaining_hours*maxload)/number_of_hours, 0)"
          },
          {
            "id": "ce3c9e74-f6b4-47fa-a828-b6714a9bc6b2",
            "key": "test_result_and_daily_normal_time",
            "value": "round((20*(Contract_load_max_normal_time - contract_demand)*addl_demand_charges)/100, 4)"
          },
          {
            "id": "c8d34ea7-600d-45f4-9a21-f3c97bd6b706",
            "key": "test_result_and_daily_peak_time",
            "value": "round((50*(Contract_load_max_peak_time - contract_demand)*30)/100, 4)"
          },
          {
            "id": "fb4cc806-5090-4c32-b7be-4cf2ea94ac66",
            "key": "test_result_and_daily_off_peak_time_case_3",
            "value": "round(off_peak_time_case_3, 4)"
          },
          {
            "id": "b3b7642f-3e61-44da-8dd8-9e0448904d3e",
            "key": "test_result_and_daily_off_peak_time_case_3a",
            "value": "round((off_peak_time_case_3a * (Contract_load_max_off_peak_time - contract_demand)) * addl_demand_charges, 4)"
          },
          {
            "id": "11e37091-3216-414a-b4ee-a71d2f94693e",
            "key": "test_result_and_daily_off_peak_time_case_3b",
            "value": "round((0.01 * 0.3 * contract_demand + off_peak_time_case_3b * (Contract_load_max_off_peak_time - 1.3 * contract_demand)) * addl_demand_charges, 4)"
          },
          {
            "id": "d8f41dec-24b2-4a27-992a-1abaddaecebf",
            "key": "test_result_and_daily_off_peak_time_case_3c",
            "value": "round((0.01 * 0.3 * contract_demand + 0.1 * 0.2 * contract_demand + off_peak_time_case_3c * (Contract_load_max_off_peak_time - 1.5 * contract_demand)) * addl_demand_charges, 4)"
          },
          {
            "id": "9ab3fbd9-4142-42e8-a541-81e8132eb11f",
            "key": "highest_value_of_case_1_2_or_3",
            "value": "max([$.test_result_and_daily_normal_time, $.test_result_and_daily_peak_time, $.test_result_and_daily_off_peak_time_case_3a, $.test_result_and_daily_off_peak_time_case_3b, $.test_result_and_daily_off_peak_time_case_3c])"
          },
          {
            "id": "4b2ce411-5ffd-4668-bcc7-2a672c1ae34b",
            "key": "net_additional_demand_charge",
            "value": "trunc($.highest_value_of_case_1_2_or_3 * multiplying_factor, 3)"
          },
          {
            "id": "6c854a88-b4b9-4b5d-b726-25fa91971eed",
            "key": "",
            "value": ""
          }
        ],
        "passThrough": true,
        "executionMode": "single"
      },
      "position": {
        "x": 1710,
        "y": 113.5
      }
