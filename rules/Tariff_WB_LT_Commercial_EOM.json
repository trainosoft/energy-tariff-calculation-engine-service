    {
      "id": "b0c1a07c-12e3-459c-b2af-ff1fab4796ba",
      "name": "Final_gross_bill",
      "type": "expressionNode",
      "content": {
        "inputField": null,
        "outputPath": null,
        "expressions": [
          {
            "id": "48af9c5f-a1a4-4589-bb44-0fe132671712",
            "key": "gross_bill_daily_calculation",
            "value": "round(fixed_charges_monthly + total_energy_chargey + differential_ECR_monthly + MVCA_monthly - ebill_opted_monthly, 4)"
          },
          {
            "id": "29a8bcb4-28c3-4987-b09a-26479a4430e8",
            "key": "end_of_month_reconcille_fixed_charges",
            "value": "round(demand_charges - fixed_charges_monthly, 4)"
          },
          {
            "id": "956736d9-47f7-4ff8-80f0-5d6d2626d79b",
            "key": "gross_bill_end_of_month_reconcille",
            "value": "round($.end_of_month_reconcille_fixed_charges + all_slab_total_energy_duty + net_additional_demand_charge, 4)"
          },
          {
            "id": "17acfbcf-c35b-4921-a55f-9dd3e7e1b733",
            "key": "final_bill_amount",
            "value": "round($.gross_bill_daily_calculation + $.gross_bill_end_of_month_reconcille, 2)"
          }
        ],
        "passThrough": true,
        "executionMode": "single"
      },
