    {
      "id": "60a83066-ee03-4dc2-bc78-27ff810dc7ae",
      "name": "calculate days per month",
      "type": "functionNode",
      "content": {
        "source": "import zen from 'zen';\r\n\r\n/** @type {Handler} **/\r\nexport const handler = async (input) => {\r\n  const { Contract_load_max_normal_time, Contract_load_max_peak_time, Contract_load_max_off_peak_time, Date: inputDate } = input;\r\n\r\n  const date = new Date(inputDate);\r\n  const year = date.getFullYear();\r\n  const month = date.getMonth() + 1;\r\n\r\n  let days;\r\n  if (month === 2) {\r\n    days = (year % 400 === 0 || (year % 4 === 0 && year % 100 !== 0)) ? 29 : 28;\r\n  } else if ([4, 6, 9, 11].includes(month)) {\r\n    days = 30;\r\n  } else {\r\n    days = 31;\r\n  }\r\n\r\n  // ---- find max + key ----\r\n  let maxKey = \"Contract_load_max_normal_time\";\r\n  let maxValue = Contract_load_max_normal_time;\r\n\r\n  if (Contract_load_max_peak_time > maxValue) {\r\n    maxKey = \"Contract_load_max_peak_time\";\r\n    maxValue = Contract_load_max_peak_time;\r\n  }\r\n  if (Contract_load_max_off_peak_time > maxValue) {\r\n    maxKey = \"Contract_load_max_off_peak_time\";\r\n    maxValue = Contract_load_max_off_peak_time;\r\n  }\r\n\r\n  // ---- dynamic output ----\r\n  return {\r\n    days,\r\n    [maxKey]: maxValue,\r\n    maxload: maxValue,\r\n    Contract_load_max_normal_time: input.Contract_load_max_normal_time,\r\n    Contract_load_max_peak_time: input.Contract_load_max_peak_time,\r\n    Contract_load_max_off_peak_time: input.Contract_load_max_off_peak_time,\r\n    consumption_unit_monthly_normal_time: input.consumption_unit_monthly_normal_time,\r\n    consumption_unit_monthly_peak_time: input.consumption_unit_monthly_peak_time,\r\n    consumption_unit_monthly_off_peak_time: input.consumption_unit_monthly_off_peak_time,\r\n    differential_ECR_monthly: input.differential_ECR_monthly,\r\n    MVCA_monthly: input.MVCA_monthly,\r\n    fixed_charges_monthly: input.fixed_charges_monthly,\r\n    ebill_opted_monthly: input.ebill_opted_monthly,\r\n  };\r\n};\r\n"
      },
      "position": {
        "x": 430,
        "y": 113.5
      }
    },
    {
      "id": "da13ba48-9a6e-4e13-ad93-6443ad0dbb62",
      "name": "All Charges",
      "type": "expressionNode",
      "content": {
        "inputField": null,
        "outputPath": null,
        "expressions": [
          {
            "id": "7babc30f-609f-4db0-9f4c-68d75f012e04",
            "key": "addl_demand_charges",
            "value": "30"
          },
          {
            "id": "fb3f08d1-30aa-46aa-9c9e-e85a7e8ef4fb",
            "key": "number_of_hours",
            "value": "days*24"
          },
          {
            "id": "73338e56-d663-4d69-a204-d254f9d07e76",
            "key": "load_shedding_hours",
            "value": "1.28"
          },
          {
            "id": "5149399e-cb75-484f-a5c4-994a549b6f38",
            "key": "computed_demand_charge",
            "value": "round($.addl_demand_charges*(($.number_of_hours - $.load_shedding_hours) * maxload)/$.number_of_hours, 4)"
          },
          {
            "id": "ca00a118-d0f6-4a98-956b-2436d0e7b873",
            "key": "multiplying_factor",
            "value": "round($.computed_demand_charge/(maxload * $.addl_demand_charges), 4)"
          },
          {
            "id": "9f5adda7-5f4c-433c-a758-121f12c148b5",
            "key": "contract_demand",
            "value": "10.0000"
          },
          {
            "id": "23b09303-4a91-45fe-ab08-73de5685f8ed",
            "key": "fixed_charges",
            "value": "30"
          },
          {
            "id": "afc0a9c2-4324-40dc-b3ec-11d6129ae71d",
            "key": "WB_LT_load_shedding_hours",
            "value": "3"
          },
          {
            "id": "48721e13-21bb-4707-9aba-09cd93fe3ebd",
            "key": "WB_LT_remaining_hours",
            "value": "$.number_of_hours - $.WB_LT_load_shedding_hours"
          },
          {
            "id": "121af931-6552-4994-abdf-d17129313022",
            "key": "Energy_charges_normal_time",
            "value": "6.66"
          },
          {
            "id": "976306f0-3601-4e88-83f4-2fe67fad8b2e",
            "key": "Energy_charges_peak_time",
            "value": "7.34"
          },
          {
            "id": "9c6889e4-4624-4b9c-9c73-45c4997a5f09",
            "key": "Energy_charges_off_peak_time",
            "value": "5.59"
          },
          {
            "id": "c7cc40aa-2f27-4881-b7c3-148ada1acc5e",
            "key": "total_consumption_units",
            "value": "consumption_unit_monthly_normal_time + consumption_unit_monthly_peak_time + consumption_unit_monthly_off_peak_time"
          },
          {
            "id": "ddcdb840-6640-4e15-b5bb-9bedab8eae5f",
            "key": "total_energy_chargey_normal_time",
            "value": "consumption_unit_monthly_normal_time * $.Energy_charges_normal_time"
          },
          {
            "id": "b3bfc061-9736-4624-a919-5936f5aa20ab",
            "key": "total_energy_chargey_peak_time",
            "value": "consumption_unit_monthly_peak_time * $.Energy_charges_peak_time"
          },
          {
            "id": "d7aab943-cee5-41ed-87c5-64c68e7dd7fc",
            "key": "total_energy_chargey_off_peak_time",
            "value": "consumption_unit_monthly_off_peak_time * $.Energy_charges_off_peak_time"
          },
          {
            "id": "e2fae942-a1d5-4ef2-9cdc-d1cf2bfe847c",
            "key": "total_energy_chargey",
            "value": "$.total_energy_chargey_normal_time + $.total_energy_chargey_peak_time + $.total_energy_chargey_off_peak_time"
          },
          {
            "id": "ee1831f1-1fa8-4da5-a9f5-3bd6cd2d6f46",
            "key": "slab_1_energy_duty_rate",
            "value": "0"
          },
          {
            "id": "8e411a35-2417-4d7a-82c5-9044ed6d2d39",
            "key": "slab_2_energy_duty_rate",
            "value": "10"
          },
          {
            "id": "a286d3b3-b073-45d1-b884-16b25bef41da",
            "key": "slab_3_energy_duty_rate",
            "value": "12.5"
          },
          {
            "id": "6f6e11c4-5c5c-4732-8ab0-77cb9335b8a1",
            "key": "slab_4_energy_duty_rate",
            "value": "15"
          }
        ],
        "passThrough": true,
        "executionMode": "single"
      },
      "position": {
        "x": 750,
