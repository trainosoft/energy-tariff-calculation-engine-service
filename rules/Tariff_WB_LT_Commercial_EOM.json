    {
      "id": "adccf515-9166-4062-b610-6bf381810ec1",
      "name": "slabwise total energy charge",
      "type": "expressionNode",
      "content": {
        "inputField": null,
        "outputPath": null,
        "expressions": [
          {
            "id": "10ddfae9-4a94-4625-bb48-3170fac7ef87",
            "key": "gross_amount",
            "value": "round(total_energy_chargey + demand_charges + net_additional_demand_charge + differential_ECR_monthly + MVCA_monthly)"
          },
          {
            "id": "493f1651-502d-451c-997c-7453d290c308",
            "key": "slab_1_total_energy_duty",
            "value": "round(($.gross_amount * units_slab_1/total_consumption_units * slab_1_energy_duty_rate)/100, 4)"
          },
          {
            "id": "db201eb6-8da0-4364-9e52-47cb8467e020",
            "key": "slab_2_total_energy_duty",
            "value": "round(($.gross_amount * units_slab_2/total_consumption_units * slab_2_energy_duty_rate)/100, 0)"
          },
          {
            "id": "288d41af-f4c4-40f6-946d-66e839b36d02",
            "key": "slab_3_total_energy_duty",
            "value": "round(($.gross_amount * units_slab_3/total_consumption_units * slab_3_energy_duty_rate)/100, 0)"
          },
          {
            "id": "7cdf9209-54b7-4b22-9cff-43aa738ae367",
            "key": "slab_4_total_energy_duty",
            "value": "round(($.gross_amount * units_slab_4/total_consumption_units * slab_4_energy_duty_rate)/100, 0)"
          },
          {
            "id": "e5ddd945-a1af-4f91-8648-53f2bd8be464",
            "key": "all_slab_total_energy_duty",
            "value": "$.slab_1_total_energy_duty + $.slab_2_total_energy_duty + $.slab_3_total_energy_duty + $.slab_4_total_energy_duty"
          }
        ],
        "passThrough": true,
