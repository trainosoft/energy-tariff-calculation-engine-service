    {
      "id": "d47bb447-9d08-4d9c-af72-7cb9e22e36b3",
      "name": "calculate days per month",
      "type": "functionNode",
      "content": {
        "source": "import zen from 'zen';\r\n\r\n/** @type {Handler} **/\r\nexport const handler = async (input) => {\r\n  const { Contract_load_normal_time, Contract_load_peak_time, Contract_load_off_peak_time, Date: inputDate } = input;\r\n\r\n  const date = new Date(inputDate);\r\n  const year = date.getFullYear();\r\n  const month = date.getMonth() + 1;\r\n\r\n  let days;\r\n  if (month === 2) {\r\n    days = (year % 400 === 0 || (year % 4 === 0 && year % 100 !== 0)) ? 29 : 28;\r\n  } else if ([4, 6, 9, 11].includes(month)) {\r\n    days = 30;\r\n  } else {\r\n    days = 31;\r\n  }\r\n\r\n  // ---- find max + key ----\r\n  let maxKey = \"Contract_load_normal_time\";\r\n  let maxValue = Contract_load_normal_time;\r\n\r\n  if (Contract_load_peak_time > maxValue) {\r\n    maxKey = \"Contract_load_peak_time\";\r\n    maxValue = Contract_load_peak_time;\r\n  }\r\n  if (Contract_load_off_peak_time > maxValue) {\r\n    maxKey = \"Contract_load_off_peak_time\";\r\n    maxValue = Contract_load_off_peak_time;\r\n  }\r\n\r\n  // ---- dynamic output ----\r\n  return {\r\n    days,\r\n    [maxKey]: maxValue,\r\n    maxload:maxValue,\r\n    last_month_unit_consumption: input.last_month_unit_consumption,\r\n    consumption_unit_normal_time: input.consumption_unit_normal_time,\r\n    consumption_unit_peak_time: input.consumption_unit_peak_time,\r\n    consumption_unit_off_peak_time: input.consumption_unit_off_peak_time,\r\n    Voucher: input.Voucher,\r\n    Opening_Balance: input.Opening_Balance,\r\n  };\r\n};\r\n"
      },
      "position": {
        "x": 430,
        "y": -32
      }
    },
