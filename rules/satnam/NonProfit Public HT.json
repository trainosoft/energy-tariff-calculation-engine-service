{
  "contentType": "application/vnd.gorules.decision",
  "nodes": [
    {
      "type": "inputNode",
      "content": {
        "schema": ""
      },
      "id": "cd228357-14c0-4165-981b-ced4332c281b",
      "name": "request",
      "position": {
        "x": 110,
        "y": 113.5
      }
    },
    {
      "type": "functionNode",
      "content": {
        "source": "import zen from 'zen';\r\n\r\n/** @type {Handler} **/\r\nexport const handler = async (input) => {\r\n  const installation_date = new Date(input.installation_date);\r\n  const date = new Date(input.current_date);\r\n  const year = date.getFullYear();\r\n  const month = date.getMonth() + 1; // JS months are 0-based\r\n\r\n  let days;\r\n\r\n  if (month === 2) {\r\n    if (year % 400 === 0 || (year % 4 === 0 && year % 100 !== 0)) {\r\n      days = 29;\r\n    } else {\r\n      days = 28;\r\n    }\r\n  } else if ([4, 6, 9, 11].includes(month)) {\r\n    days = 30;\r\n  } else {\r\n    days = 31;\r\n  }\r\n\r\n  const installation_only_date = installation_date.getDate();\r\n  const installation_month_year = String(installation_date.getMonth() + 1).padStart(2, '0') + \"-\" + installation_date.getFullYear();\r\n  const current_month_year = String(date.getMonth() + 1).padStart(2, '0') + \"-\" + date.getFullYear();\r\n\r\n  return {\r\n    ...input,\r\n    days,\r\n    installation_only_date,\r\n    installation_month_year,\r\n    current_month_year\r\n  };\r\n};\r\n"
      },
      "id": "076f05aa-787d-41f0-8361-1541b156e93d",
      "name": "calculate days per month",
      "position": {
        "x": 430,
        "y": 113.5
      }
    },
    {
      "type": "expressionNode",
      "content": {
        "expressions": [
          {
            "id": "0934be9f-c3fb-45b9-ad80-e3cea7225616",
            "key": "bill_days",
            "value": "current_month_year == installation_month_year ? days - installation_only_date + 1  : days"
          },
          {
            "id": "35a9c788-11e3-4291-a3ff-2855b420d242",
            "key": "demand_charge_per_month_per_kVA",
            "value": "60"
          },
          {
            "id": "adc36936-0031-43c0-9689-cf56f2fdc7f3",
            "key": "bill_factor",
            "value": "round(round($.bill_days/days, 5), 4)"
          },
          {
            "id": "49ccacce-caee-4412-b09a-d5ce0773d4de",
            "key": "existing_demand_charge",
            "value": "round($.demand_charge_per_month_per_kVA * contracted_load ,2)"
          },
          {
            "id": "d9d64ebb-c605-4d5d-831c-ee8ce25e76d5",
            "key": "adjusted_fixed_charges_for_month",
            "value": "round($.existing_demand_charge * $.bill_factor, 4)"
          },
          {
            "id": "36fe22e5-bd23-42bd-b515-54bd9d3b1a36",
            "key": "daily_fixed_charges",
            "value": "round($.adjusted_fixed_charges_for_month/$.bill_days, 4)"
          },
          {
            "id": "320b3e26-08b2-4b10-a2ad-8e73d146e92b",
            "key": "surcharge_rate",
            "value": "2"
          },
          {
            "id": "880ba4cf-7c45-4ed4-bd03-74de81920b10",
            "key": "energy_charges_rate_per_unit",
            "value": "8.75"
          },
          {
            "id": "287775c9-1769-43ee-be97-7f19dbfe9251",
            "key": "power_factor",
            "value": "0.99"
          },
          {
            "id": "054b2a1c-feaf-49dd-b99a-4546a3474fed",
            "key": "consumed_units",
            "value": "current_reading - previous_reading"
          },
          {
            "id": "0f17ac3c-6f4b-4228-b255-169364a24a33",
            "key": "update_consumed_units",
            "value": "round($.consumed_units/$.power_factor, 4)"
          }
        ],
        "passThrough": true,
        "inputField": null,
        "outputPath": null,
        "executionMode": "single"
      },
      "id": "a9263212-4c30-4596-a1d1-412f2ca88d79",
      "name": "Calculation parameters",
      "position": {
        "x": 750,
        "y": 113.5
      }
    },
    {
      "type": "expressionNode",
      "content": {
        "expressions": [
          {
            "id": "c57f2b54-a19f-4c40-9f0b-7ac8967759e2",
            "key": "electricity_charge",
            "value": "round(date(current_date) < date(installation_date) ? 0 : update_consumed_units * energy_charges_rate_per_unit, 4)"
          },
          {
            "id": "80b4d6ee-5b06-4ae2-82c7-b4b6aed98f5a",
            "key": "demand_charges",
            "value": "date(current_date) < date(installation_date) ? 0 : daily_fixed_charges"
          },
          {
            "id": "b9a8fc01-592f-4e9b-8770-c56a6d08410f",
            "key": "gross_bill",
            "value": "$.electricity_charge + $.demand_charges"
          },
          {
            "id": "9b8d31e6-c3bc-41b2-a6b1-0e54336231d2",
            "key": "surcharge",
            "value": "round(surcharge_rate * $.gross_bill/100, 4)"
          },
          {
            "id": "f289a097-e2c8-4b1b-865e-0cdb746e4951",
            "key": "gross_deduction",
            "value": "$.gross_bill + $.surcharge"
          },
          {
            "id": "6016e90f-8a75-49db-afe4-b2ad3673989a",
            "key": "recharge_amount",
            "value": "date(current_date) < date(installation_date) ? 0 : opening_balance"
          },
          {
            "id": "80eeaf80-d9cf-4c6f-8685-c6b9424a06f4",
            "key": "update_closing_balance",
            "value": "date(current_date) < date(installation_date) ? 0 : date(current_date) == date(installation_date) ? $.recharge_amount - $.gross_deduction : closing_balance - $.gross_deduction + $.recharge_amount"
          }
        ],
        "passThrough": true,
        "inputField": null,
        "outputPath": null,
        "executionMode": "single"
      },
      "id": "9e13dda5-9174-4d55-b769-04e1e9c136d9",
