    {
      "type": "expressionNode",
      "content": {
        "expressions": [
          {
            "id": "d1e3745d-ad5a-43e9-99d3-3f015aef1529",
            "key": "fixed_charges",
            "value": "date(current_date) < date(installation_date) ? 0 : daily_fixed_charges"
          },
          {
            "id": "572f6cc4-214a-40ce-b9e2-0dc4a2825aec",
            "key": "gross_bill",
            "value": "electricity_charge_slab_1 + electricity_charge_slab_2 + $.fixed_charges"
          },
          {
            "id": "9b5246df-a396-452e-87b8-5998124e1c72",
            "key": "surcharge",
            "value": "trunc(surcharge_rate * $.gross_bill/100, 4)"
          },
          {
            "id": "26c2d28b-6007-4b09-94ee-d529c36baeec",
            "key": "gross_deduction",
            "value": "$.gross_bill + $.surcharge"
          },
          {
            "id": "9bd06b93-3946-4e72-ada1-1f3543ecb6b4",
            "key": "recharge_amount",
            "value": "date(current_date) < date(installation_date) ? 0 : opening_balance"
          },
          {
            "id": "cdd16f39-14b4-4840-91ce-35ddbef77e31",
            "key": "update_closing_balance",
            "value": "date(current_date) < date(installation_date) ? 0 : date(current_date) == date(installation_date) ? $.recharge_amount - $.gross_deduction : closing_balance - $.gross_deduction + $.recharge_amount"
          }
        ],
        "passThrough": true,
