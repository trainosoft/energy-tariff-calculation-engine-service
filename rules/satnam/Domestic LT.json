        "x": 60,
        "y": 295
      }
    },
    {
      "type": "expressionNode",
      "content": {
        "expressions": [
          {
            "id": "462f0381-45a2-470e-8051-467f2b41c561",
            "key": "bill_days",
            "value": "current_month_year == installation_month_year ? days - installation_only_date + 1  : days"
          },
          {
            "id": "46925e21-b29a-4b22-bf66-eab89ab4386b",
            "key": "fixed_charge_per_month_per_KW",
            "value": "50"
          },
          {
            "id": "60a6e411-ba53-4dab-aff7-f43f772d10fc",
            "key": "bill_factor",
            "value": "round(round($.bill_days/days, 5), 4)"
          },
          {
            "id": "5e450230-6dcb-44fa-b923-d4bc79918652",
            "key": "existing_fixed_charges",
            "value": "round($.fixed_charge_per_month_per_KW * contracted_load_KW ,2)"
          },
          {
            "id": "af9d4809-623a-4ca4-a0a8-8fb9b5a2bd98",
            "key": "adjusted_fixed_charges_for_month",
            "value": "round($.existing_fixed_charges * $.bill_factor, 4)"
          },
          {
            "id": "c1150fc0-7975-426b-ab7a-dca4949b0841",
            "key": "daily_fixed_charges",
            "value": "round($.adjusted_fixed_charges_for_month/$.bill_days, 4)"
          },
          {
            "id": "a6f6d7ac-36a8-4247-8394-4df6a1a3207d",
            "key": "consumed_units",
            "value": "current_reading - previous_reading"
          },
          {
            "id": "97c9966e-6865-4d73-b5a8-744962b72b9b",
            "key": "surcharge_rate",
            "value": "2"
          },
          {
            "id": "40b8a189-2886-4dcf-9c2d-87ab50b1224a",
            "key": "original_slab_1_size_domestic_LT",
            "value": "100"
          },
          {
            "id": "937c8971-55d2-4ed9-947a-ffb200cb1512",
            "key": "original_slab_2_size_domestic_LT",
            "value": "200"
          },
          {
            "id": "fa765fe2-63a8-4124-937d-7e5d5c89e45f",
            "key": "adjusted_slab_1_limit",
            "value": "$.original_slab_1_size_domestic_LT * $.bill_factor"
          },
          {
            "id": "10d3f64a-8b4f-4b72-af51-3de32d7b9f2b",
            "key": "adjusted_slab_2_limit",
            "value": "$.original_slab_2_size_domestic_LT * $.bill_factor"
          },
          {
            "id": "4109d2fa-83e2-4763-b35d-2421799dfd99",
            "key": "adjusted_slab_3_limit",
            "value": "$.adjusted_slab_2_limit + 0.01"
          }
        ],
        "passThrough": true,
