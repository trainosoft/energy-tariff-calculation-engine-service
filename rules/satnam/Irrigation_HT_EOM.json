            "key": "update_demand_charges",
            "value": "date(current_date) < date(installation_date) ? 0 : daily_fixed_charges"
          },
          {
            "id": "e23301d4-d215-4c2b-90ec-65d11850ca59",
            "key": "update_surcharge",
            "value": "round(((pervious_electricity_charge + $.update_demand_charges) * surcharge_rate)/100, 4)"
          },
