            "key": "total_bill",
            "value": "round(Opening_Balance-($.fixed_charges_per_day + $.total_energy_charges + $.total_Differential_ECR + $.total_MVCA + $.total_ED_Duty_in_RS_slab_1 + $.total_ED_Duty_in_RS_slab_2 - $.total_rebate_in_RS - $.total_Ebill_Opted), 2)"
          }
        ],
