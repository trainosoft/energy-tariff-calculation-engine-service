            "key": "total_energy_charges",
            "value": "round(consumption_units*Energy_charges, 2)"
          },
          {
            "id": "db4960f8-69c3-4d65-bfbc-1a93b88fcdee",
            "key": "total_Differential_ECR",
            "value": "round($.Differential_ECR*last_month_unit_consumption, 2)"
          },
          {
            "id": "953c028b-b1c0-4190-8488-9d42fbd50bd2",
            "key": "total_MVCA",
            "value": "round($.MVCA*last_month_unit_consumption, 2)"
          },
          {
            "id": "05fe8f70-52f1-46d3-87ac-05198960af54",
            "key": "total_ED_Duty_in_RS_slab_1",
            "value": "round(($.total_energy_charges + $.total_Differential_ECR + $.total_MVCA)*slab_1/100, 2)"
          },
