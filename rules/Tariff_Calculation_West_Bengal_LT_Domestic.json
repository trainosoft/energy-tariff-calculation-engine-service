    {
      "type": "functionNode",
      "content": {
        "source": "import zen from 'zen';\r\n\r\n/** @type {Handler} **/\r\nexport const handler = async (input) => {\r\n  const date = new Date(input.Date);\r\n  const year = date.getFullYear();\r\n  const month = date.getMonth() + 1; // JS months are 0-based\r\n\r\n  let days;\r\n\r\n  if (month === 2) {\r\n    if (year % 400 === 0 || (year % 4 === 0 && year % 100 !== 0)) {\r\n      days = 29;\r\n    } else {\r\n      days = 28;\r\n    }\r\n  } else if ([4, 6, 9, 11].includes(month)) {\r\n    days = 30;\r\n  } else {\r\n    days = 31;\r\n  }\r\n\r\n  return {\r\n    days,\r\n    DVC_provide_ECR: input.DVC_provide_ECR,\r\n    DVC_provide_MVCA: input.DVC_provide_MVCA,\r\n    last_month_unit_consumption: input.last_month_unit_consumption,\r\n    Opening_Balance: input.Opening_Balance,\r\n    consumption_units: input.consumption_units,\r\n    Voucher: input.Voucher,\r\n    Cumulative_Consumption_units_raw: input.Cumulative_Consumption_units_raw\r\n  };\r\n};\r\n"
      },
      "id": "a45f4006-eb08-4926-ba07-f82c650343a6",
      "name": "calculate days per month",
      "position": {
        "x": 335,
