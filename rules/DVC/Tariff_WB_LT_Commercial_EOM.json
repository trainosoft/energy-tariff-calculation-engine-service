    {
      "id": "15a6cd3e-9217-4643-a1d6-74914a006326",
      "name": "calculate days per month",
      "type": "functionNode",
      "content": {
        "source": "import zen from 'zen';\n\n/** @type {Handler} **/\nexport const handler = async (input) => {\n  const { consumption_max_load_normal_time_monthly, consumption_max_load_peak_time_monthly, consumption_max_load_off_peak_time_monthly, current_date } = input;\n\n  const date = new Date(current_date);\n  const year = date.getFullYear();\n  const month = date.getMonth() + 1;\n\n  let days;\n  if (month === 2) {\n    days = (year % 400 === 0 || (year % 4 === 0 && year % 100 !== 0)) ? 29 : 28;\n  } else if ([4, 6, 9, 11].includes(month)) {\n    days = 30;\n  } else {\n    days = 31;\n  }\n\n  // ---- find max + key ----\n  let maxKey = \"consumption_max_load_normal_time_monthly\";\n  let maxValue = consumption_max_load_normal_time_monthly;\n\n  if (consumption_max_load_peak_time_monthly > maxValue) {\n    maxKey = \"consumption_max_load_peak_time_monthly\";\n    maxValue = consumption_max_load_peak_time_monthly;\n  }\n  if (consumption_max_load_off_peak_time_monthly > maxValue) {\n    maxKey = \"consumption_max_load_off_peak_time_monthly\";\n    maxValue = consumption_max_load_off_peak_time_monthly;\n  }\n\n  // ---- dynamic output ----\n  return {\n    ...input,\n    days,\n    [maxKey]: maxValue,\n    contract_demand_max: maxValue\n  };\n};\n"
      },
      "position": {
        "x": 430,
        "y": 113.5
      }
    },
    {
      "id": "e49dc7ee-5658-4bf1-85cc-1ddb86e1ab25",
      "name": "Calculation parameters",
      "type": "expressionNode",
      "content": {
        "inputField": null,
        "outputPath": null,
        "expressions": [
          {
            "id": "51e5240d-a086-40b1-a485-956dd5faa3d4",
            "key": "addl_demand_charges_per_KVA",
            "value": "30"
          },
          {
            "id": "f8eb207c-f874-4764-af95-e7c2a91b817a",
            "key": "number_of_hours_in_month",
            "value": "days * 24"
          },
          {
            "id": "0904f9bc-f973-44bb-9db3-758c2df35e3a",
            "key": "EHi_load_shedding_hours",
            "value": "1.28"
          },
          {
            "id": "039439c3-bff5-42c5-b457-19b3745e53ef",
            "key": "computed_demand_charge",
            "value": "round($.addl_demand_charges_per_KVA * (($.number_of_hours_in_month - $.EHi_load_shedding_hours) * contract_demand_max)/$.number_of_hours_in_month, 4)"
          },
          {
            "id": "f7bf7efa-d4fa-4278-9fcf-62ec958aa412",
            "key": "multiplying_factor",
            "value": "round($.computed_demand_charge/(contract_demand_max * $.addl_demand_charges_per_KVA), 4)"
          },
          {
            "id": "9544b26b-bb1e-4375-9fbc-421c56e7f05c",
            "key": "fixed_charge_per_connection",
            "value": "30"
          },
          {
            "id": "e5273d84-5962-4cd0-a7c6-ba1edb6c1c5e",
            "key": "contract_demand",
            "value": "10.0000"
          },
          {
            "id": "aa8ea6b5-f9bb-497b-9d9e-48f130323fb7",
            "key": "load_shedding_hours",
            "value": "3"
          },
          {
            "id": "d857bb59-2f4d-4555-9655-bf00781cdd2d",
            "key": "remaining_hours",
            "value": "$.number_of_hours_in_month - $.load_shedding_hours"
          },
          {
            "id": "ff94b76f-f331-4c10-ac54-496b866e426c",
            "key": "energy_charge_per_unit_normal_time",
            "value": "6.66"
          },
          {
            "id": "30b953a3-4ccf-44ac-9924-744494e6c513",
            "key": "energy_charge_per_unit_peak_time",
            "value": "7.34"
          },
          {
            "id": "036f9be2-d58c-48cf-b4d9-425ce3c37ac8",
            "key": "energy_charge_per_unit_off_peak_time",
            "value": "5.59"
          },
          {
            "id": "1506fe90-3119-47b4-a46b-ce0f24c51ba6",
            "key": "energy_duty_slab_1_rate",
            "value": "0"
          },
          {
            "id": "10f22c26-7f97-4b2c-9d20-74009cca29cd",
            "key": "energy_duty_slab_2_rate",
            "value": "10"
          },
          {
            "id": "3c20fc51-8e5b-40df-98ec-e4230ef5a629",
            "key": "energy_duty_slab_3_rate",
            "value": "12.5"
          },
          {
            "id": "bc74aeec-d523-4138-8b74-391eecd09a44",
            "key": "energy_duty_slab_4_rate",
            "value": "15"
          },
          {
            "id": "c1b217ee-de2f-4db2-aa7a-76f802465c4e",
            "key": "penalty_rate_on_contract_demand_normal_time",
            "value": "20"
          },
          {
            "id": "5f87c96c-4f1a-4c74-afba-7a5a185537d1",
            "key": "penalty_rate_on_contract_demand_peak_time",
            "value": "50"
          },
          {
            "id": "2afc200f-a49f-46e7-a22d-1596bf2972b0",
            "key": "total_consumption_unit_monthly",
            "value": "consumption_units_monthly_normal_time + consumption_units_monthly_peak_time + consumption_units_monthly_off_peak_time"
          },
          {
            "id": "49850a2e-d2ad-4693-bafd-176929f2a384",
            "key": "total_differential_ECR_flat",
            "value": "round(total_differential_ECR, 0)"
          }
        ],
        "passThrough": true,
        "executionMode": "single"
      },
      "position": {
        "x": 750,
