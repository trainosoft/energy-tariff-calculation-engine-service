    {
      "id": "37fc3ead-78c7-4c7d-9dd6-c444546b9e64",
      "name": "Energy duty calculation",
      "type": "expressionNode",
      "content": {
        "inputField": null,
        "outputPath": null,
        "expressions": [
          {
            "id": "f9931435-87e2-47c3-9857-9f5e830c24d2",
            "key": "energy_charges_normal_time_in_RS",
            "value": "consumption_units_monthly_normal_time * energy_charge_per_unit_normal_time"
          },
          {
            "id": "236ef1a8-4368-40f8-b62b-eb74da525f97",
            "key": "energy_charges_peak_time_in_RS",
            "value": "consumption_units_monthly_peak_time * energy_charge_per_unit_peak_time"
          },
          {
            "id": "5bb1946f-6984-42e1-b74f-96901e7ecbbb",
            "key": "energy_charges_off_peak_time_in_RS",
            "value": "consumption_units_monthly_off_peak_time * energy_charge_per_unit_off_peak_time"
          },
          {
            "id": "2c4c17e6-7f4f-4662-ba0c-6aec3f6ee76b",
            "key": "total_energy_charges",
            "value": "$.energy_charges_normal_time_in_RS + $.energy_charges_peak_time_in_RS + $.energy_charges_off_peak_time_in_RS"
          },
          {
            "id": "92a63b7a-54d9-46d1-abac-f262416a56db",
            "key": "ED_gross_amount",
            "value": "trunc($.total_energy_charges + additional_MD_demand_charge + net_additional_demand_charge + total_differential_ECR_flat + total_MVCA, 0)"
          },
          {
            "id": "11e114ac-ec4b-481e-b2ef-f100441a9a63",
            "key": "slab_1_energy_duty",
            "value": "round(($.ED_gross_amount * units_slab_1/total_consumption_unit_monthly * energy_duty_slab_1_rate)/100)"
          },
          {
            "id": "6fe24d66-53ae-431b-b4ad-5c34c00bdd9d",
            "key": "slab_2_energy_duty",
            "value": "round(($.ED_gross_amount * units_slab_2/total_consumption_unit_monthly * energy_duty_slab_2_rate)/100)"
          },
          {
            "id": "d3313f9c-ec8b-406f-8430-2e929a0b6ef4",
            "key": "slab_3_energy_duty",
            "value": "round(($.ED_gross_amount * units_slab_3/total_consumption_unit_monthly * energy_duty_slab_3_rate)/100)"
          },
          {
            "id": "5347f503-6e7f-487d-b684-bf4a5bb2f8de",
            "key": "slab_4_energy_duty",
            "value": "round(($.ED_gross_amount * units_slab_4/total_consumption_unit_monthly * energy_duty_slab_4_rate)/100)"
          },
          {
            "id": "7189f663-85c1-4ee4-a9b5-ffffb75434e7",
            "key": "total_energy_duty",
            "value": "$.slab_1_energy_duty + $.slab_2_energy_duty + $.slab_3_energy_duty + $.slab_4_energy_duty"
          }
        ],
