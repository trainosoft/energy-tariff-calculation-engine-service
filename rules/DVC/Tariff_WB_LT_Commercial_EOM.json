    {
      "id": "8d83dff6-ccd9-4530-ad44-755e5ea0ba7b",
      "name": "Addl MD calcutation",
      "type": "expressionNode",
      "content": {
        "inputField": null,
        "outputPath": null,
        "expressions": [
          {
            "id": "7b04bcef-aa35-41f1-b43b-daeed4dd999c",
            "key": "additional_demand_charge_normal_time",
            "value": "(penalty_rate_on_contract_demand_normal_time/100) * (consumption_max_load_normal_time_monthly - contract_demand) * addl_demand_charges_per_KVA"
          },
          {
            "id": "ed9e4ffa-69d4-4d18-9339-b044b705a80c",
            "key": "additional_demand_charge_peak_time",
            "value": "(penalty_rate_on_contract_demand_peak_time/100) * (consumption_max_load_peak_time_monthly - contract_demand) * addl_demand_charges_per_KVA"
          },
          {
            "id": "029c9e3b-34db-41d3-99bf-8a8d6b325de4",
            "key": "additional_demand_charge_off_peak_time_case_3",
            "value": "penalty_rate_on_contract_demand_off_peak_time_case_3"
          },
          {
            "id": "2b8e8e1d-d215-4479-b70d-26206bf76bc2",
            "key": "additional_demand_charge_off_peak_time_case_3a",
            "value": "(penalty_rate_on_contract_demand_off_peak_time_case_3a/100) * (consumption_max_load_off_peak_time_monthly - contract_demand) * addl_demand_charges_per_KVA"
          },
          {
            "id": "79e11257-2edf-406c-ac05-756071dd1b8c",
            "key": "additional_demand_charge_off_peak_time_case_3b",
            "value": "((penalty_rate_on_contract_demand_off_peak_time_case_3a/100) * 0.3 * contract_demand + (penalty_rate_on_contract_demand_off_peak_time_case_3b/100) * (consumption_max_load_off_peak_time_monthly - 1.3 * contract_demand)) * addl_demand_charges_per_KVA"
          },
          {
            "id": "e032bca1-20e8-4cf6-9555-94d067c4e782",
            "key": "additional_demand_charge_off_peak_time_case_3c",
            "value": "((penalty_rate_on_contract_demand_off_peak_time_case_3a/100) * 0.3 * contract_demand + (penalty_rate_on_contract_demand_off_peak_time_case_3b/100) * 0.2 * contract_demand + (penalty_rate_on_contract_demand_off_peak_time_case_3c/100)*(consumption_max_load_off_peak_time_monthly - 1.5 * contract_demand)) * addl_demand_charges_per_KVA"
          },
          {
            "id": "b9516736-4cf0-4f25-9d0d-37a65f8a51c6",
            "key": "max_additional_demand_charge",
            "value": "max([$.additional_demand_charge_normal_time, $.additional_demand_charge_peak_time, $.additional_demand_charge_off_peak_time_case_3a, $.additional_demand_charge_off_peak_time_case_3b, $.additional_demand_charge_off_peak_time_case_3c])"
          },
          {
            "id": "e2d9c005-cf74-4e78-8d61-0157b63a5709",
            "key": "net_additional_demand_charge",
            "value": "trunc($.max_additional_demand_charge * multiplying_factor, 2)"
          },
          {
            "id": "001208ab-8ed6-4f4b-bb12-5bd46ebb978a",
            "key": "additional_MD_demand_charge",
            "value": "round((fixed_charge_per_connection * remaining_hours * contract_demand_max)/number_of_hours_in_month, 0)"
          }
        ],
        "passThrough": true,
        "executionMode": "single"
      },
      "position": {
        "x": 1390,
        "y": 113.5
