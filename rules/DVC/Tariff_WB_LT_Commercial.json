    {
      "type": "functionNode",
      "content": {
        "source": "import zen from 'zen';\r\n\r\n/** @type {Handler} **/\r\nexport const handler = async (input) => {\r\n  const { consumption_load_normal_time, consumption_load_peak_time, consumption_load_off_peak_time, current_date } = input;\r\n\r\n  const date = new Date(current_date);\r\n  const year = date.getFullYear();\r\n  const month = date.getMonth() + 1;\r\n\r\n  let days;\r\n  if (month === 2) {\r\n    days = (year % 400 === 0 || (year % 4 === 0 && year % 100 !== 0)) ? 29 : 28;\r\n  } else if ([4, 6, 9, 11].includes(month)) {\r\n    days = 30;\r\n  } else {\r\n    days = 31;\r\n  }\r\n\r\n  // ---- find max + key ----\r\n  let maxKey = \"consumption_load_normal_time\";\r\n  let maxValue = consumption_load_normal_time;\r\n\r\n  if (consumption_load_peak_time > maxValue) {\r\n    maxKey = \"consumption_load_peak_time\";\r\n    maxValue = consumption_load_peak_time;\r\n  }\r\n  if (consumption_load_off_peak_time > maxValue) {\r\n    maxKey = \"consumption_load_off_peak_time\";\r\n    maxValue = consumption_load_off_peak_time;\r\n  }\r\n\r\n  // ---- dynamic output ----\r\n  return {\r\n    ...input,\r\n    days,\r\n    [maxKey]: maxValue,\r\n    contract_demand_max: maxValue\r\n  };\r\n};\r\n"
      },
      "id": "5c722c5a-4cc7-4c25-bada-716cf0b60130",
      "name": "calculate days per month",
      "position": {
        "x": 290,
