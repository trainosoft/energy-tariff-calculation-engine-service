      "content": {
        "expressions": [
          {
            "id": "4bdabc6a-68ab-4029-a1b8-e3e5f6387ce8",
            "key": "fixed_charge",
            "value": "round(round((fixed_charge_per_connection * remaining_hours * contract_demand_max )/number_of_hours_in_month , 0)/days, 3)"
          },
          {
            "id": "89af48e4-ad81-4e8e-883b-591e629e55fc",
            "key": "energy_charge",
            "value": "round(daily_energy_charge_normal_time + daily_energy_charge_peak_time + daily_energy_charge_off_peak_time, 2)"
          },
          {
            "id": "4f101d7f-cb17-4bfc-a409-0f40ecfe3abd",
            "key": "differential_ECR",
            "value": "round(last_month_consumption_unit_daily * differential_ECR_EC, 4)"
          },
          {
            "id": "e3b1efe1-e779-4c8a-9227-331c400b7dcc",
            "key": "MVCA",
            "value": "round(last_month_consumption_unit_daily * MVCA_rate, 4)"
          },
          {
            "id": "5cec99cf-2e2c-4281-b643-50597192f10f",
            "key": "rebate",
            "value": "round(voucher_amount * (100+1)/100, 4)"
          },
          {
            "id": "71fd2d80-cd63-4832-a8b4-ca4415653f3f",
            "key": "rebate_on_ebill",
            "value": "round(rebate_on_ebill_per_month / days, 4)"
          },
          {
            "id": "a4e42f99-fd45-4297-80c9-29612b4e5bf0",
            "key": "updated_opening_balance",
            "value": "round(round(opening_balance-($.fixed_charge + $.energy_charge + $.differential_ECR + $.MVCA), 4) + $.rebate + $.rebate_on_ebill, 2)"
          },
          {
            "id": "d5f4f3a1-4616-427e-8e3b-c1ffaae4f1b2",
            "key": "final_bill_amount",
            "value": "round(round($.fixed_charge + $.energy_charge + $.differential_ECR + $.MVCA, 4) + $.rebate + $.rebate_on_ebill, 2)"
          }
        ],
