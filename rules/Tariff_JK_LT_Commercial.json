    {
      "id": "1d00827d-a59a-43b6-884a-d8b80034a798",
      "name": "calculate days per month",
      "type": "functionNode",
      "content": {
        "source": "import zen from 'zen';\r\n\r\n/** @type {Handler} **/\r\nexport const handler = async (input) => {\r\n  const date = new Date(input.current_date);\r\n  const year = date.getFullYear();\r\n  const month = date.getMonth() + 1; // JS months are 0-based\r\n\r\n  let days;\r\n\r\n  if (month === 2) {\r\n    if (year % 400 === 0 || (year % 4 === 0 && year % 100 !== 0)) {\r\n      days = 29;\r\n    } else {\r\n      days = 28;\r\n    }\r\n  } else if ([4, 6, 9, 11].includes(month)) {\r\n    days = 30;\r\n  } else {\r\n    days = 31;\r\n  }\r\n\r\n  return {\r\n    ...input,\r\n    days\r\n  };\r\n};\r\n"
      },
      "position": {
        "x": 295,
        "y": 250
      }
    },
    {
      "id": "b3795dde-a737-442e-a001-ccc611f2ae49",
      "name": "Bill calculation",
      "type": "expressionNode",
      "content": {
        "inputField": null,
        "outputPath": null,
        "expressions": [
          {
            "id": "6d63bb6d-e954-4032-ba99-86d11a794399",
            "key": "fixed_charge",
            "value": "round(contract_demand_in_KW * (fixed_charge_per_connection/days), 4)"
          },
          {
            "id": "0e92c930-5e8d-49a4-bbe8-ac14c77a82ea",
            "key": "energy_charge",
            "value": "round(consumption_unit * energy_charge_per_unit, 4)"
          },
          {
            "id": "b9adea42-9526-41be-9828-6f5b7d65f70f",
            "key": "FPPAS_charge",
            "value": "round(last_month_unit_consumption * FPPAS, 4)"
          },
          {
            "id": "f3d3417e-81fe-4286-9d3f-15ff54318128",
            "key": "energy_duty",
            "value": "round(energy_duty_on_EC_FPPAS * ($.energy_charge + $.FPPAS_charge)/100, 4)"
          },
          {
            "id": "f46a9759-af6a-4df2-b41f-e466cdd5db61",
            "key": "rebate",
            "value": "round((-$.energy_charge * rebate_on_energy_charge)/100, 4)"
          },
          {
            "id": "befbf535-e555-46a4-9187-90a2a33647b3",
            "key": "penalty_on_contract_demand",
            "value": "round(penalty_rate_on_contract_demand * fixed_charge_per_connection * (contract_demand_in_KW - contract_demand), 4)"
          },
          {
            "id": "5ed73c60-d751-48b4-b8fd-8ea325c4e765",
            "key": "update_opening_balance",
            "value": "round(opening_balance - ($.fixed_charge + $.energy_charge + $.FPPAS_charge + $.energy_duty + $.rebate + $.penalty_on_contract_demand + difference), 2)"
          },
          {
            "id": "6bed860d-d6cd-4da4-80e7-d3020f885b85",
            "key": "final_bill_amount",
            "value": "round($.fixed_charge + $.energy_charge + $.FPPAS_charge + $.energy_duty + $.rebate + $.penalty_on_contract_demand + difference, 2)"
          }
        ],
        "passThrough": true,
        "executionMode": "single"
      },
