      "id": "3bdd0fdc-ad27-42ae-bb3d-c3e395f0bc6e",
      "name": "All Charges",
      "position": {
        "x": 600,
        "y": 250
      }
    },
    {
      "type": "functionNode",
      "content": {
        "source": "import zen from 'zen';\r\n\r\n/** @type {Handler} **/\r\nexport const handler = async (input) => {\r\n  const date = new Date(input.Date);\r\n  const year = date.getFullYear();\r\n  const month = date.getMonth() + 1; // JS months are 0-based\r\n\r\n  let days;\r\n\r\n  if (month === 2) {\r\n    if (year % 400 === 0 || (year % 4 === 0 && year % 100 !== 0)) {\r\n      days = 29;\r\n    } else {\r\n      days = 28;\r\n    }\r\n  } else if ([4, 6, 9, 11].includes(month)) {\r\n    days = 30;\r\n  } else {\r\n    days = 31;\r\n  }\r\n\r\n  return {\r\n    days,\r\n    consumption_unit: input.consumption_unit,\r\n    last_month_unit_consumption: input.last_month_unit_consumption,\r\n    Contract_Demand_in_kW: input.Contract_Demand_in_kW,\r\n    Opening_Balance: input.Opening_Balance,\r\n    difference: input.difference,\r\n  };\r\n};\r\n"
      },
      "id": "1d00827d-a59a-43b6-884a-d8b80034a798",
      "name": "calculate days per month",
      "position": {
        "x": 295,
        "y": 250
      }
    },
    {
      "type": "expressionNode",
      "content": {
        "expressions": [
          {
            "id": "6d63bb6d-e954-4032-ba99-86d11a794399",
            "key": "fixed_charges_per_day",
            "value": "round(Contract_Demand_in_kW*(Fixed_charges/days), 2)"
          },
          {
            "id": "0e92c930-5e8d-49a4-bbe8-ac14c77a82ea",
            "key": "total_energy_charges",
            "value": "round(consumption_unit*Energy_charges, 2)"
          },
          {
            "id": "b9adea42-9526-41be-9828-6f5b7d65f70f",
            "key": "total_FPPAS_charges",
            "value": "round(last_month_unit_consumption*FPPAS_charges, 2)"
          },
          {
            "id": "f3d3417e-81fe-4286-9d3f-15ff54318128",
            "key": "total_energy_duty",
            "value": "round(Energy_duty*($.total_energy_charges+$.total_FPPAS_charges)/100, 2)"
          },
          {
            "id": "f46a9759-af6a-4df2-b41f-e466cdd5db61",
            "key": "total_rebate",
            "value": "round((-$.total_energy_charges*Rebate)/100, 2)"
          },
          {
            "id": "befbf535-e555-46a4-9187-90a2a33647b3",
            "key": "total_Penalty",
            "value": "round(Penalty*1.5*Fixed_charges*(Contract_Demand_in_kW-Contract_Demand), 2)"
          },
          {
            "id": "5ed73c60-d751-48b4-b8fd-8ea325c4e765",
            "key": "update_opening_balance",
            "value": "round(Opening_Balance - ($.fixed_charges_per_day + $.total_energy_charges + $.total_FPPAS_charges + $.total_energy_duty + $.total_rebate + $.total_Penalty + difference), 2)"
          },
          {
            "id": "6bed860d-d6cd-4da4-80e7-d3020f885b85",
            "key": "final_bill_amount",
            "value": "round($.fixed_charges_per_day + $.total_energy_charges + $.total_FPPAS_charges + $.total_energy_duty + $.total_rebate + $.total_Penalty + difference, 2)"
          }
        ],
        "passThrough": true,
        "inputField": null,
        "outputPath": null,
        "executionMode": "single"
      },
